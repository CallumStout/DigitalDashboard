<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DigitalDashboard.ViewModels"
             xmlns:models="using:DigitalDashboard.Models"
             x:Class="DigitalDashboard.Views.ClockView"
             x:DataType="vm:ClockViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#EAF0F7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9BAAB9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9BAAB9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#191F28"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#253140"/>
            <Setter Property="Foreground" Value="#EAF0F7"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#253140"/>
            <Setter Property="Foreground" Value="#9BAAB9"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#00C7E8"/>
            <Setter Property="Foreground" Value="#07222D"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#00C7E8"/>
            <Setter Property="Foreground" Value="#07222D"/>
        </Style>
        <!-- Touch drivers may leave the pointer hovering after release. Keep
             transport colours stable in that state; only a held press darkens. -->
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#253140"/>
            <Setter Property="Foreground" Value="#EAF0F7"/>
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#34465B"/>
            <Setter Property="Foreground" Value="#EAF0F7"/>
        </Style>
        <Style Selector="Button.transport.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ED760"/>
            <Setter Property="Foreground" Value="#092416"/>
        </Style>
        <Style Selector="Button.transport.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#17AD4D"/>
            <Setter Property="Foreground" Value="#092416"/>
        </Style>
        <Style Selector="Button.transport.play:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ED760"/>
            <Setter Property="Foreground" Value="#092416"/>
        </Style>
    </UserControl.Styles>
    <Grid Background="#0E131B" RowDefinitions="36,*">
        <Grid ColumnDefinitions="*,Auto" Margin="14,0">
            <TextBlock Text="DIGITAL HOME" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#8CDDED"/>
            <TextBlock Grid.Column="1" Text="HOME OVERVIEW" Classes="label" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="104,*">
            <Border Background="#151C25" Padding="6,8">
                <Grid RowDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <Button x:Name="OverviewButton" Classes="nav active" Content="Overview" Click="Navigate" Tag="Overview"/>
                        <Button Classes="nav" Content="Climate" Click="Navigate" Tag="Climate"/>
                        <Button Classes="nav" Content="Plugs" Click="Navigate" Tag="Plugs"/>
                        <Button Classes="nav" Content="Security" Click="Navigate" Tag="Security"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="YOUR HOME&#10;AT A GLANCE" Classes="label" Margin="6,0,0,8"/>
                </Grid>
            </Border>
            <Grid x:Name="OverviewPanel" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="8,0,8,8">
                <!-- Each column fits the 800 x 480 baseline without scaling touch targets. -->
                <Grid RowDefinitions="126,*" Margin="0,0,4,0">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="WELCOME HOME" Classes="label" Foreground="#55DDB4"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Time}" FontSize="44" FontWeight="Bold"/>
                            </Viewbox>
                            <TextBlock Text="{Binding Date}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="UPCOMING AGENDA" Classes="label" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="EventsScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CalendarEvents}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CalendarEventModel">
                                            <Border Background="#212B37" CornerRadius="7" Padding="10" MinHeight="70" BorderBrush="#00C7E8" BorderThickness="3,0,0,0">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="12" Foreground="#8CDDED"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="No upcoming events" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoCalendarEvents}"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="*,158" Margin="4,0">
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="LOCAL WEATHER" Classes="label" Margin="0,0,0,8"/>
                            <ScrollViewer x:Name="WeatherScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="No weather location configured" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoWeatherLocations}"/>
                                    <ItemsControl ItemsSource="{Binding WeatherLocations}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WeatherLocationViewModel">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Temperature}" FontSize="38" FontWeight="Bold"/>
                                                        <TextBlock Text="°C" Foreground="#F5BC58" FontSize="20" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,Auto,*,48">
                            <TextBlock Text="PLUG OVERVIEW" Classes="label" Foreground="#8CDDED"/>
                            <TextBlock Grid.Row="1" Text="{Binding PlugSummary}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding PlugAvailability}" Classes="muted" VerticalAlignment="Center"/>
                            <Button Grid.Row="3" Content="View plugs" Click="Navigate" Tag="Plugs" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2" RowDefinitions="132,100,*" Margin="4,0,0,0">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="THERMOSTAT" Classes="label"/>
                            <Grid ColumnDefinitions="48,*,48">
                                <Button Content="−" FontSize="24" IsEnabled="False" AutomationProperties.Name="Lower temperature"/>
                                <TextBlock Grid.Column="1" Text="—°C" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="+" FontSize="24" IsEnabled="False" AutomationProperties.Name="Raise temperature"/>
                            </Grid>
                            <TextBlock Text="Not connected" Classes="muted"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <Border Classes="card" Margin="0,0,4,0" Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="LIGHTS" Classes="label" Foreground="#F5BC58"/>
                                <TextBlock Text="Not&#10;connected" Classes="muted"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card" Margin="4,0,0,0" Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="DOOR" Classes="label" Foreground="#8CDDED"/>
                                <TextBlock Text="Not&#10;connected" Classes="muted"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Classes="card" Margin="0,8,0,0" Background="#192621" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Spotify.AlbumArtwork}" Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <TextBlock Text="♫" IsVisible="{Binding !Spotify.HasArtwork}" FontSize="64"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38634B"/>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#B0000000"/>
                                        <GradientStop Offset="0.35" Color="#20000000"/>
                                        <GradientStop Offset="0.65" Color="#A0000000"/>
                                        <GradientStop Offset="1" Color="#F0101814"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid RowDefinitions="Auto,*,Auto,48" Margin="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="♫  SPOTIFY" Classes="label" Foreground="#1ED760"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Spotify.Status}" FontSize="11" Foreground="#EAF0F7"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,8,0,10">
                                    <TextBlock Text="{Binding Spotify.TrackName}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Spotify.ArtistName}" FontSize="13" Foreground="#D7E2DC"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="3" ColumnDefinitions="*,*,*">
                                    <Button Classes="transport" Content="|‹" Command="{Binding Spotify.PreviousTrackCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" FontSize="20" AutomationProperties.Name="Previous track"/>
                                    <Button Classes="transport play" Grid.Column="1" Content="{Binding Spotify.PlaybackIcon}" Command="{Binding Spotify.TogglePlaybackCommand}" Margin="4,0" HorizontalAlignment="Stretch" FontSize="20" Background="#1ED760" Foreground="#092416" CornerRadius="24" AutomationProperties.Name="{Binding Spotify.PlaybackLabel}"/>
                                    <Button Classes="transport" Grid.Column="2" Content="›|" Command="{Binding Spotify.NextTrackCommand}" Margin="4,0,0,0" HorizontalAlignment="Stretch" FontSize="20" AutomationProperties.Name="Next track"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="PlugsPanel" Grid.Column="1" Margin="8,0,8,8" RowDefinitions="Auto,*" IsVisible="False">
                <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SMART PLUGS" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PlugAvailability}" Classes="muted"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PlugSummary}" FontSize="18" Foreground="#8CDDED" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="PlugsScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SmartPlugs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SmartPlugViewModel">
                                <Border Classes="card" MinHeight="96">
                                    <Grid ColumnDefinitions="*,150,100">
                                        <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" Classes="muted"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding PowerButtonText}" Command="{Binding ToggleCommand}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="56" Margin="0,0,8,0" Padding="8,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Change power for {0}'}"/>
                                        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="56" Padding="8,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Refresh status for {0}'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" IsVisible="{Binding HasNoSmartPlugs}" Text="No plugs connected yet" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="FeaturePanel" Grid.Column="1" Classes="card" Margin="8,0,8,8" IsVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="400">
                    <TextBlock x:Name="FeatureTitle" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Not connected" Foreground="#8CDDED" FontSize="18" TextAlignment="Center"/>
                    <TextBlock x:Name="FeatureDescription" TextWrapping="Wrap" TextAlignment="Center" Classes="muted"/>
                    <Button Content="Back to overview" Click="Navigate" Tag="Overview" HorizontalAlignment="Center" Padding="20,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
