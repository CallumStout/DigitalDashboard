<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DigitalDashboard.ViewModels"
             xmlns:models="using:DigitalDashboard.Models"
             x:Class="DigitalDashboard.Views.ClockView"
             x:DataType="vm:ClockViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <!-- Touch drivers may leave the pointer hovering after release. Keep
             transport colours stable in that state; only a held press darkens. -->
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.transport.play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TertiaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <Style Selector="Button.transport.play:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TertiaryPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
        <Style Selector="Button.transport.play:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TertiaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid Background="{DynamicResource CanvasBrush}" RowDefinitions="36,*">
        <Grid ColumnDefinitions="*,Auto" Margin="14,0">
            <TextBlock Text="DIGITAL HOME" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimarySoftBrush}"/>
            <TextBlock Grid.Column="1" Text="HOME OVERVIEW" Classes="label" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="104,*">
            <Border Background="{DynamicResource SidebarBrush}" Padding="6,8">
                <Grid RowDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <Button x:Name="OverviewButton" Classes="nav active" Content="Overview" Click="Navigate" Tag="Overview"/>
                        <Button Classes="nav" Content="Climate" Click="Navigate" Tag="Climate"/>
                        <Button Classes="nav" Content="Plugs" Click="Navigate" Tag="Plugs"/>
                        <Button Classes="nav" Content="Security" Click="Navigate" Tag="Security"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Night mode" Classes="label" FontSize="12" TextAlignment="Center"/>
                        <ToggleSwitch IsChecked="{Binding IsNightMode, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      AutomationProperties.Name="Night mode"
                                      HorizontalAlignment="Center"
                                      MinHeight="44"
                                      Margin="0,0,0,8"/>
                        <TextBlock Text="YOUR HOME&#10;AT A GLANCE" Classes="label" FontSize="12" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="OverviewPanel" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="8,0,8,8">
                <!-- Each column fits the 800 x 480 baseline without scaling touch targets. -->
                <Grid RowDefinitions="126,*" Margin="0,0,4,0">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="WELCOME HOME" Classes="label" Foreground="{DynamicResource TertiaryBrush}"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Time}" FontSize="44" FontWeight="Bold"/>
                            </Viewbox>
                            <TextBlock Text="{Binding Date}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="UPCOMING AGENDA" Classes="label" Margin="0,0,0,10"/>
                            <ScrollViewer x:Name="EventsScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CalendarEvents}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CalendarEventModel">
                                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="7" Padding="10" MinHeight="70" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3,0,0,0">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="14" Foreground="{DynamicResource PrimarySoftBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="No upcoming events" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoCalendarEvents}"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="*,186" Margin="4,0">
                    <Border Classes="card" Padding="8">
                        <!-- Centre navigation in the space remaining below the forecast. -->
                        <Grid x:Name="WeatherLayout" RowDefinitions="Auto,*" SizeChanged="WeatherLayoutSizeChanged">
                            <TextBlock Text="No weather location configured" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoWeatherLocations}"/>
                            <ScrollViewer x:Name="WeatherScroller" Background="Transparent" IsScrollInertiaEnabled="True"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{Binding SelectedWeatherLocation}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:WeatherLocationViewModel">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                                                <Grid ColumnDefinitions="*,56" Height="50">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <TextBlock Text="{Binding Temperature}" FontSize="44" FontWeight="Bold"/>
                                                        <TextBlock Text="°C" Foreground="{DynamicResource SecondaryBrush}" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" Foreground="{DynamicResource SecondaryBrush}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" FontSize="16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                <Border Background="{DynamicResource CanvasBrush}" CornerRadius="7" Padding="4,8">
                                                    <Grid ColumnDefinitions="*,*,1.4*">
                                                        <StackPanel><TextBlock Text="HUMIDITY" FontSize="12" Classes="label" HorizontalAlignment="Center"/><TextBlock Text="{Binding Humidity}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                                        <StackPanel Grid.Column="1"><TextBlock Text="UV INDEX" FontSize="12" Classes="label" HorizontalAlignment="Center"/><TextBlock Text="{Binding Uv}" FontSize="18" Foreground="{DynamicResource SecondaryBrush}" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Text="WIND" FontSize="12" Classes="label" HorizontalAlignment="Center"/><TextBlock Text="{Binding Wind}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch"/></StackPanel>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="NEXT 12 HOURS" FontSize="12" Classes="label" Margin="0,2,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Forecast}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:WeatherForecast">
                                                            <Border Background="{DynamicResource ControlBrush}" CornerRadius="6" Margin="1,0" Padding="1,3" ToolTip.Tip="{Binding Description}">
                                                                <Grid RowDefinitions="18,28,24">
                                                                    <TextBlock Grid.Row="0" Text="{Binding Time}" FontSize="12"
                                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                                    <Border Grid.Row="1" Width="26" Height="26"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Viewbox Width="22" Height="22" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Icon}" FontSize="20" TextAlignment="Center"
                                                                                       Foreground="{DynamicResource SecondaryBrush}"/>
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="2" Text="{Binding Temperature}" FontSize="16" FontWeight="Bold"
                                                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </ScrollViewer>
                            <Grid x:Name="WeatherNavigation" Grid.Row="1" ColumnDefinitions="48,*,48" Margin="0,10,0,6" VerticalAlignment="Center" IsVisible="{Binding HasMultipleWeatherLocations}">
                                <Button Content="‹" FontSize="24" Command="{Binding PreviousWeatherLocationCommand}" AutomationProperties.Name="Previous weather location"/>
                                <TextBlock Grid.Column="1" Text="{Binding WeatherLocationPosition}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="›" FontSize="24" Command="{Binding NextWeatherLocationCommand}" AutomationProperties.Name="Next weather location"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto,Auto,*,48">
                            <TextBlock Text="PLUG OVERVIEW" Classes="label" Foreground="{DynamicResource PrimarySoftBrush}"/>
                            <TextBlock Grid.Row="1" Text="{Binding PlugSummary}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding PlugAvailability}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Row="3" Content="View plugs" Click="Navigate" Tag="Plugs" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2" RowDefinitions="132,132,*" Margin="4,0,0,0">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="THERMOSTAT" Classes="label"/>
                            <Grid ColumnDefinitions="48,*,48">
                                <Button Content="−" FontSize="24" IsEnabled="False" AutomationProperties.Name="Lower temperature"/>
                                <TextBlock Grid.Column="1" Text="—°C" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="+" FontSize="24" IsEnabled="False" AutomationProperties.Name="Raise temperature"/>
                            </Grid>
                            <TextBlock Text="Not connected" Classes="muted"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="card" Margin="0,8,0,0" Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="4">
                            <TextBlock Text="LIGHTS" Classes="label" Foreground="{DynamicResource SecondaryBrush}"/>
                            <ScrollViewer x:Name="LightsScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasOverviewLights}">
                                <ItemsControl ItemsSource="{Binding OverviewLights}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="{Binding OverviewLightColumns}"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SmartDeviceViewModel">
                                            <Grid RowDefinitions="28,48" RowSpacing="4" Margin="2,0,2,4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}"/>
                                                <Button Grid.Row="1" Command="{Binding ToggleCommand}"
                                                        HorizontalAlignment="Stretch" Padding="4,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Toggle power for {0}'}"
                                                        ToolTip.Tip="{Binding PowerButtonText}">
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Text="&#x23FB;" FontSize="18" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="14"
                                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Spacing="4" IsVisible="{Binding !HasOverviewLights}">
                                <TextBlock Text="No lights available" Classes="muted" FontSize="14" TextWrapping="Wrap"/>
                                <Button Content="View devices" Click="Navigate" Tag="Plugs" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Open device controls"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Classes="card" Margin="0,8,0,0" Background="{DynamicResource CardBrush}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Spotify.AlbumArtwork}" Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <TextBlock Text="♫" IsVisible="{Binding !Spotify.HasArtwork}" FontSize="64"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TertiaryDimBrush}"/>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="{DynamicResource ArtworkShadeTop}"/>
                                        <GradientStop Offset="0.35" Color="{DynamicResource ArtworkShadeMiddle}"/>
                                        <GradientStop Offset="0.65" Color="{DynamicResource ArtworkShadeLower}"/>
                                        <GradientStop Offset="1" Color="{DynamicResource ArtworkShadeBottom}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid RowDefinitions="Auto,*,Auto,48" Margin="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="♫  SPOTIFY" Classes="label" Foreground="{DynamicResource TertiaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Spotify.Status}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,8,0,10">
                                    <TextBlock Text="{Binding Spotify.TrackName}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Spotify.ArtistName}" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="3" ColumnDefinitions="*,*,*">
                                    <Button Classes="transport" Content="|‹" Command="{Binding Spotify.PreviousTrackCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" FontSize="20" AutomationProperties.Name="Previous track"/>
                                    <Button Classes="transport play" Grid.Column="1" Content="{Binding Spotify.PlaybackIcon}" Command="{Binding Spotify.TogglePlaybackCommand}" Margin="4,0" HorizontalAlignment="Stretch" FontSize="20" Background="{DynamicResource TertiaryBrush}" Foreground="{DynamicResource CanvasBrush}" CornerRadius="24" AutomationProperties.Name="{Binding Spotify.PlaybackLabel}"/>
                                    <Button Classes="transport" Grid.Column="2" Content="›|" Command="{Binding Spotify.NextTrackCommand}" Margin="4,0,0,0" HorizontalAlignment="Stretch" FontSize="20" AutomationProperties.Name="Next track"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="PlugsPanel" Grid.Column="1" Margin="8,0,8,8" RowDefinitions="Auto,*" IsVisible="False">
                <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SMART DEVICES" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PlugAvailability}" Classes="muted"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlugSummary}" FontSize="18" Foreground="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center"/>
                            <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" Padding="16,0"
                                    AutomationProperties.Name="Refresh device list"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="PlugsScroller" Grid.Row="1" Background="Transparent" IsScrollInertiaEnabled="True"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SmartDevices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SmartDeviceViewModel">
                                <Border Classes="card" Padding="16" Width="320" MinHeight="184" Margin="0,0,8,8" VerticalAlignment="Top">
                                    <Grid RowDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Type}" Classes="muted" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" Classes="muted" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" IsVisible="{Binding SupportsBrightness}" Margin="0,12,0,0" Spacing="4">
                                            <TextBlock Text="{Binding Brightness, StringFormat='Set brightness · {0}%'}" Classes="muted"/>
                                            <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding CanAdjustBrightness}"
                                                    MinHeight="48" AutomationProperties.Name="{Binding Name, StringFormat='Set brightness for {0}'}"/>
                                        </StackPanel>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*" IsVisible="{Binding SupportsPresets}" Margin="0,8,0,0">
                                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="relax"
                                                    HorizontalAlignment="Stretch" Margin="0,0,4,0" Padding="8" MinHeight="56"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Relax preset for {0}: 30 percent, warm white'}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Relax" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="30% · Warm" Classes="muted" FontSize="14" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Command="{Binding ApplyPresetCommand}" CommandParameter="bright"
                                                    HorizontalAlignment="Stretch" Margin="4,0,0,0" Padding="8" MinHeight="56"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Bright preset for {0}: 100 percent, cool white'}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Bright" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="100% · Cool" Classes="muted" FontSize="14" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                            <Button Content="{Binding PowerButtonText}" Command="{Binding ToggleCommand}"
                                                    HorizontalAlignment="Stretch" MinWidth="144" Padding="16,0"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Change power for {0}'}"/>
                                            <Button Grid.Column="1" Content="Retry" Command="{Binding RefreshCommand}" IsVisible="{Binding !HasState}"
                                                    HorizontalAlignment="Stretch" Padding="16,0" Margin="8,0,0,0"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Refresh status for {0}'}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" IsVisible="{Binding HasNoSmartPlugs}" Text="No devices connected yet" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="FeaturePanel" Grid.Column="1" Classes="card" Margin="8,0,8,8" IsVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="400">
                    <TextBlock x:Name="FeatureTitle" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Not connected" Foreground="{DynamicResource PrimarySoftBrush}" FontSize="18" TextAlignment="Center"/>
                    <TextBlock x:Name="FeatureDescription" TextWrapping="Wrap" TextAlignment="Center" Classes="muted"/>
                    <Button Content="Back to overview" Click="Navigate" Tag="Overview" HorizontalAlignment="Center" Padding="20,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.RowSpan="2"
                Background="Black"
                Opacity="0.75"
                IsVisible="{Binding IsNightMode}"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
