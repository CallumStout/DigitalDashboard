<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DigitalDashboard.ViewModels"
             xmlns:models="using:DigitalDashboard.Models"
             x:Class="DigitalDashboard.Views.ClockView"
             x:DataType="vm:ClockViewModel">

	<Grid Background="#101319">
            <Grid ColumnDefinitions="200,*"
                  MaxWidth="960"
                  HorizontalAlignment="Stretch"
                  Margin="16"
                  VerticalAlignment="Stretch">
                <ScrollViewer x:Name="WeatherScroller"
                              Grid.Column="0"
                              Margin="0,0,16,0"
                              Background="Transparent"
                              IsScrollInertiaEnabled="True"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                            HorizontalAlignment="Stretch"
                            Spacing="16">
                    <TextBlock Text="Weather"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F4F7FC"/>

				<TextBlock Text="Add places to appsettings.json, then restart."
	                       IsVisible="{Binding HasNoWeatherLocations}"
	                       FontSize="16"
	                       Foreground="#AAAAAA"
	                       TextWrapping="Wrap"/>

                <ItemsControl ItemsSource="{Binding WeatherLocations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:WeatherLocationViewModel">
                            <Border
                                    Padding="16,14"
                                    CornerRadius="18"
                                    BorderBrush="#2A3547"
                                    BorderThickness="1"
                                    BoxShadow="0 8 24 0 #22000000">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#1D2939"/>
                                        <GradientStop Offset="1" Color="#151C27"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="Medium"
                                                   Foreground="#C2CDDD"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Grid.Column="1"
                                                 Width="6"
                                                 Height="6"
                                                 Margin="10,0,0,0"
                                                 Fill="#7DD3FC"
                                                 VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Temperature}"
                                                   FontSize="36"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F4F7FC"/>
                                        <TextBlock Text="°C"
                                                   FontSize="20"
                                                   Foreground="#8DA4BF"
                                                   Margin="0,9,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="14"
                                               Foreground="#9FB1C5"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1"
                      RowDefinitions="Auto,*"
                      HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Stretch">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Time}"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontFamily="Consolas"/>
                        </Viewbox>
                        <TextBlock Text="{Binding Date}"
                                   FontSize="18"
                                   Foreground="#8F9BAE"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*">
                        <TextBlock Text="Upcoming Events"
                                   Margin="0,0,0,16"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F4F7FC"/>

                        <ScrollViewer x:Name="EventsScroller"
                                      Grid.Row="1"
                                      Background="Transparent"
                                      IsScrollInertiaEnabled="True"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CalendarEvents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CalendarEventModel">
                                    <Border Background="#202936"
                                            CornerRadius="12"
                                            BorderBrush="#2A3547"
                                            BorderThickness="1"
                                            Padding="20,16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:ddd dd MMM}'}"
                                                   FontSize="13"
                                                   Foreground="#9FB1C5"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="17"
                                                   FontWeight="Medium"
                                                   Foreground="#F4F7FC"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="No upcoming events"
                                   Grid.Row="1"
                                   VerticalAlignment="Top"
                                   Foreground="#F4F7FC"
                                   Opacity="0.6"
                                   IsVisible="{Binding HasNoCalendarEvents}"/>
                    </Grid>
                </Grid>
            </Grid>

	</Grid>
</UserControl>
